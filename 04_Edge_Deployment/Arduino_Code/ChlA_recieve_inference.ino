void setup() {
    Serial.begin(115200);     // PC debug
    Serial1.begin(250000);    // ESP32 UART
    delay(1000);
    Serial.println("Nano BLE Ready");
}

void loop() {
    if (Serial1.available() > 0) {
        receiveData();
    }
}

void receiveData() {

    const uint8_t START_BYTE = 0x11;
    const uint8_t PIXEL_START_MARKER = 0xA5;
    const uint8_t PIXEL_END_MARKER = 0x5A;

    static uint8_t state = 0;
    static uint16_t pixelIndex = 0;
    static uint16_t pixelValue = 0;

    while (Serial1.available() > 0) {

        uint8_t incomingByte = Serial1.read();

        switch (state) {

            case 0:
                if (incomingByte == START_BYTE) {
                    pixelIndex = 0;
                    state = 1;
                }
                break;

            case 1:
                if (incomingByte == PIXEL_START_MARKER) {
                    state = 2;
                }
                break;

            case 2:
                pixelValue = incomingByte;
                state = 3;
                break;

            case 3:
                pixelValue |= (incomingByte << 8);
                state = 4;
                break;

            case 4:
                if (incomingByte == PIXEL_END_MARKER) {

                    if (pixelIndex < PIXEL_COUNT) {
                        pixBuf[pixelIndex++] = pixelValue;
                    }

                    if (pixelIndex >= PIXEL_COUNT) {

                        Serial.println("All pixels received.");

                        processSpectrum();   //Run full pipeline

                        state = 0;
                        return;
                    }

                    state = 1;
                }
                break;

            default:
                state = 0;
                break;
        }
    }
}

void processSpectrum() {

    // Step 1: Compute SVD
    computeSVD();

    // Step 2: Polynomial Expansion
    polynomialExpansion();

    // Step 3: Run Inference
    runInference();
}

void computeSVD() {
    for (int i = 0; i < SVD_COMPONENTS; i++) {
        for (int j = 0; j < PIXEL_COUNT; j++) {
            reduced_data[i] += SVD_MATRIX[i][j] * pixBuf[j];
        }
    }
}

void polynomialExpansion() {
    int index = 0;

    // Bias term
    input_data[index++] = 1.0;

    // Add the 11 SVD components
    for (int i = 0; i < SVD_COMPONENTS; i++) {
        input_data[index++] = reduced_data[i];
    }

    // Add squared and interaction terms
    for (int i = 0; i < SVD_COMPONENTS; i++) {
        for (int j = i; j < SVD_COMPONENTS; j++) {
            input_data[index++] = reduced_data[i] * reduced_data[j];
        }
    }
}


// Function to run inference using Edge Impulse model
void runInference() {

    // Prepare signal object for Edge Impulse
    signal_t signal;
    int err = numpy::signal_from_buffer(input_data, INPUT_SIZE, &signal);
    if (err != 0) {
        Serial.println("Failed to create signal from buffer.");
        return;
    }

    // Run inference
    ei_impulse_result_t result;
    err = run_classifier(&signal, &result, false);
    if (err != EI_IMPULSE_OK) {
        Serial.print("Inference failed: ");
        Serial.println(err);
        return;
    }

    // Print Chl-a concentration prediction
    Serial.println("Inference Results:");
    Serial.print("Predicted Chl-a Concentration: ");
    Serial.println(result.classification[0].value, 6);  // Print with 6 decimal places
}
